# Copy this file to `.env` and fill in the values.
# Never commit your real `.env` file.

# Public base URL of the app (used for share links and the embed snippet).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Postgres connection strings (Project → Connect → ORMs → Prisma).
# Transaction pooler, port 6543 — used by the running app:
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler, port 5432 — used for migrations:
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"